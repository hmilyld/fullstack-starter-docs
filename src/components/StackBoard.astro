---
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';

const t = {
  zh: {
    label: '选择技术栈',
    front: '前端',
    back: '后端',
    output: '生成结果',
    name: 'my-project',
    icName: ['全栈', '工坊'],
    modules: '内置模块',
    modulesValue: '认证 · 用户 · 角色 · 权限 · AI 模型 · 审计',
    ports: ['前端 :5173', '后端 :8088'],
    hint: '选择前端与后端，查看将生成的项目。',
  },
  en: {
    label: 'Choose a stack',
    front: 'Frontend',
    back: 'Backend',
    output: 'Output',
    name: 'my-project',
    icName: ['FULL', 'FORGE'],
    modules: 'Built-in',
    modulesValue: 'auth · users · roles · permissions · ai models · audit',
    ports: ['frontend :5173', 'backend :8088'],
    hint: 'Pick a frontend and a backend to see what you get.',
  },
}[lang];
---

<section class="ff-stack" aria-label={t.hint} data-lang={lang}>
  <div class="ff-stack__head">
    <span class="ff-label">{t.label}</span>
    <span class="ff-stack__hint">{t.hint}</span>
  </div>

  <div class="ff-stack__row">
    <div class="ff-stack__group">
      <span class="ff-label">{t.front}</span>
      <div class="ff-stack__chips" role="radiogroup" aria-label={t.front}>
        <button type="button" class="ff-chip" role="radio" aria-checked="true" tabindex="0" data-side="front" data-value="react">React</button>
        <button type="button" class="ff-chip" role="radio" aria-checked="false" tabindex="-1" data-side="front" data-value="vue">Vue</button>
        <button type="button" class="ff-chip" role="radio" aria-checked="false" tabindex="-1" data-side="front" data-value="svelte">Svelte</button>
      </div>
    </div>

    <div class="ff-stack__group">
      <span class="ff-label">{t.back}</span>
      <div class="ff-stack__chips" role="radiogroup" aria-label={t.back}>
        <button type="button" class="ff-chip" role="radio" aria-checked="true" tabindex="0" data-side="back" data-value="python">Python</button>
        <button type="button" class="ff-chip" role="radio" aria-checked="false" tabindex="-1" data-side="back" data-value="java">Java</button>
      </div>
    </div>
  </div>

  <div class="ff-stack__out">
    <div class="ff-stack__out-head">
      <span class="ff-label">{t.output}</span>
      <code class="ff-stack__name">{t.name}/</code>
    </div>
    <pre class="ff-stack__tree" data-tree></pre>
    <dl class="ff-stack__meta">
      <div>
        <dt class="ff-label">{t.modules}</dt>
        <dd>{t.modulesValue}</dd>
      </div>
      <div>
        <dt class="ff-label">Ports</dt>
        <dd class="ff-stack__ports">
          {t.ports.map((p) => <span>{p}</span>)}
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .ff-stack {
    margin: 2rem 0 1rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ff-radius-xl);
    background: var(--card);
  }

  .ff-stack__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-bottom: 1.25rem;
  }

  .ff-stack__hint {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .ff-stack__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .ff-stack__group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ff-stack__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Starlight spaces adjacent markdown siblings; these are controls, not prose. */
  .ff-stack .ff-stack__chips .ff-chip,
  .ff-stack .ff-stack__out .ff-stack__tree,
  .ff-stack .ff-stack__meta div {
    margin: 0;
  }

  .ff-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    min-width: 5.5rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ff-radius-xl);
    background: var(--background);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .ff-chip:hover {
    background: var(--sidebar-accent);
    color: var(--sl-color-gray-1);
  }

  .ff-chip[aria-checked='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }

  .ff-stack__out {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .ff-stack__out-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .ff-stack__name {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-1);
    background: none;
    border: none;
    padding: 0;
  }

  .ff-stack__tree {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ff-radius-lg);
    background: var(--muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.75;
    color: var(--sl-color-gray-2);
    overflow-x: auto;
  }

  .ff-stack__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin: 0.9rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }

  .ff-stack__meta div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
  }

  .ff-stack__meta dd {
    margin: 0;
  }

  .ff-stack__ports {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-1);
  }

  /* Compact: one column, and keep the tap targets at 44px */
  @media (max-width: 47.99rem) {
    .ff-stack__row {
      grid-template-columns: 1fr;
    }

    .ff-chip {
      min-height: 2.75rem;
    }
  }
</style>

<script>
  type Side = 'front' | 'back';

  const stacks: Record<string, Record<string, string>> = {
    react: {
      python: 'React + Vite + Tailwind + shadcn/ui · FastAPI + SQLAlchemy async',
      java: 'React + Vite + Tailwind + shadcn/ui · Spring Boot 3.2 + JPA',
    },
    vue: {
      python: 'Vue 3 + Vite + Tailwind + shadcn-vue · FastAPI + SQLAlchemy async',
      java: 'Vue 3 + Vite + Tailwind + shadcn-vue · Spring Boot 3.2 + JPA',
    },
    svelte: {
      python: 'SvelteKit 3 + Tailwind + shadcn-svelte · FastAPI + SQLAlchemy async',
      java: 'SvelteKit 3 + Tailwind + shadcn-svelte · Spring Boot 3.2 + JPA',
    },
  };

  const labels = {
    zh: { frontend: '前端', backend: '后端', nginx: 'Nginx', single: '单镜像' },
    en: { frontend: 'frontend', backend: 'backend', nginx: 'Nginx', single: 'single image' },
  };

  document.querySelectorAll<HTMLElement>('.ff-stack').forEach((board) => {
    const treeEl = board.querySelector<HTMLElement>('[data-tree]')!;
    const chips = [...board.querySelectorAll<HTMLButtonElement>('.ff-chip')];
    const lang = board.dataset.lang === 'en' ? 'en' : 'zh';
    const state: Record<Side, string> = { front: 'react', back: 'python' };

    function render() {
      const [fe, be] = stacks[state.front][state.back].split(' · ');
      const l = labels[lang as 'zh' | 'en'];
      treeEl.textContent =
        `my-project/\n` +
        `├─ frontend/          # ${fe}\n` +
        `├─ backend/           # ${be}\n` +
        `├─ Dockerfile         # ${l.nginx} + ${l.backend} · ${l.single}\n` +
        `├─ docker-compose.yml\n` +
        `└─ dev.sh             # ./dev.sh start`;
    }

    function setSide(side: Side, value: string) {
      state[side] = value;
      chips
        .filter((chip) => chip.dataset.side === side)
        .forEach((chip) => {
          const on = chip.dataset.value === value;
          chip.setAttribute('aria-checked', String(on));
          chip.tabIndex = on ? 0 : -1;
        });
      render();
    }

    (['front', 'back'] as Side[]).forEach((side) => {
      const group = chips.filter((chip) => chip.dataset.side === side);
      group.forEach((chip, i) => {
        chip.addEventListener('click', () => setSide(side, chip.dataset.value!));
        chip.addEventListener('keydown', (event) => {
          const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'];
          if (!keys.includes(event.key)) return;
          event.preventDefault();
          const dir = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1;
          const next = group[(i + dir + group.length) % group.length];
          next.focus();
          setSide(side, next.dataset.value!);
        });
      });
    });

    render();
  });
</script>
